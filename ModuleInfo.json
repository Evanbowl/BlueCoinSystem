{
  "Name": "BlueCoinSystem",
  "Author": "Evanbowl and Lord-Giganticus",
  "Description": "PTD: Full Blue Coin System",
  "CompilerFlags" : [
    "-DBLUECOINSYSTEM",
    "-DBLUECOINBOARD" 
  ],
  "InstallDependancies": ["CoinBase", "ExtStationedFileTable", "PTUtils", "Syati_ExtGameData", "Syati_Init", "Syati_ObjectFactories"],
  "RequiredAPIs": ["PTUtils", "CoinBase_API", "Syati_ExtGameData_API"],
  "SupportedGames": [
    "SB4E",
    "SB4P",
    "SB4J"
  ],
  "ModuleData" : [
    {
      "NameObjFactory": [
        {
          "Name" : "BlueCoin",
          "Function" : "BlueCoinUtil::createBlueCoin",
          "Include" : "BlueCoinUtil.h"
        },
        {
          "Name" : "BlueCoinSign",
          "Function" : "BlueCoinSignUtil::createBlueCoinSign",
          "Include" : "BlueCoinBoard.h"
        }
      ],
      "StationedFileEntry" : [
        {
          "Type1" : "1",
          "Type2" : "6",
          "Path" : "/ObjectData/BlueCoin.arc"
        },
        {
          "Type1" : "1",
          "Type2" : "6",
          "Path" : "/ObjectData/BlueCoinClear.arc"
        },
        {
          "Type1" : "1",
          "Type2" : "7",
          "Path" : "/LayoutData/BlueCoinCounterInStage.arc"
        },
        {
          "Type1" : "1",
          "Type2" : "1",
          "Path" : "/SystemData/BlueCoinIDRangeTable.arc"
        }
      ],
      "CoinBaseSpawning": [
        {
          "ID" : "1",
          "CoinCreateFunc" : "BlueCoinUtil::tryCreateBlueCoinForSpawningActorActionKeeper",
          "CoinAppearFunc" : "BlueCoinUtil::tryAppearBlueCoinActionKeeper",
          "Include" : "BlueCoinUtil.h"
        }
      ],
      "BranchFlow": [
        {
          "ID" : "27",
          "BranchFunc": "BlueCoinUtil::isBlueCoinGotCurrentFile",
          "Include": "BlueCoinUtil.h"
        },
        {
          "ID" : "28",
          "BranchFunc": "BlueCoinUtil::isOnBlueCoinFlagCurrentFile",
          "Include": "BlueCoinUtil.h"
        }
      ],
      "EventFlow": [
        {
          "ID" : "22",
          "EventFunc": "BlueCoinUtil::setBlueCoinGotCurrentFile",
          "Include": "BlueCoinUtil.h"
        },
        {
          "ID" : "23",
          "EventFunc": "BlueCoinUtil::setOnBlueCoinFlagCurrentFile",
          "Include": "BlueCoinUtil.h"
        }
      ],
      "ReplaceTag" : [
        {
          "ByteData": "20, 0, 0, 0",
          "ReplaceFunc": "BlueCoinReplaceTag::getTotalBlueCoinNumCurrentFileForMsg",
          "Include": "BlueCoinUtil.h"
        },
        {
          "ByteData": "21, 0, 0, 0",
          "ReplaceFunc": "BlueCoinReplaceTag::calcBlueCoinTotalInRangeForMsg",
          "Include": "BlueCoinUtil.h"
        },
        {
          "ByteData": "22, 0, 0, 0",
          "ReplaceFunc": "BlueCoinReplaceTag::getSpentBlueCoinNumCurrentFileForMsg",
          "Include": "BlueCoinUtil.h"
        }
      ],
      "NewSaveChunk": [
        {
          "ChunkMemberType": "BlueCoinDataStorage",
          "ChunkMemberName": "mBlueCoinDataStorage",
          "ChunkCreationFunc": "createBinaryChunk<BlueCoinDataStorage>",
          "Include": "BlueCoinDataStorage.h"
        }
      ]
    }
  ]
}
